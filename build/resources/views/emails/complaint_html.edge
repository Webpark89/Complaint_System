<!DOCTYPE html>
<html lang="th">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>สถานะเรื่องร้องเรียน</title>
</head>

<body
  style="margin: 0; padding: 0; background-color: #f4f6f8; font-family: 'Sarabun', 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; color: #1e293b;">

  <!-- Outer Background Table -->
  <table width="100%" border="0" cellspacing="0" cellpadding="0" style="background-color: #f4f6f8; width: 100%;">
    <tr>
      <td align="center" style="padding: 30px 10px;">

        <!-- Main Email Container Card -->
        <table width="100%" border="0" cellspacing="0" cellpadding="0"
          style="max-width: 650px; background-color: #ffffff; border-radius: 8px; border: 1px solid #e2e8f0; border-collapse: separate; overflow: hidden;">

          <!-- Header Row -->
          <tr>
            <td style="padding: 20px 24px; background-color: #f8fafc; border-bottom: 1px solid #e2e8f0;">
              <table width="100%" border="0" cellspacing="0" cellpadding="0">
                <tr>
                  <td align="left" style="font-size: 20px; font-weight: bold; color: #0f2d4a;">
                    สถานะเรื่องร้องเรียน
                  </td>
                  <td align="right">
                    <!-- Status Badge -->
                    <span
                      style="background-color: #f59e0b; color: #ffffff; font-weight: bold; font-size: 14px; padding: 6px 16px; border-radius: 6px; display: inline-block;">
                      {{status}}
                    </span>
                  </td>
                </tr>
              </table>
            </td>
          </tr>

          <!-- Body Row -->
          <tr>
            <td style="padding: 24px;">

              <!-- Inner Info Card Box -->
              <table width="100%" border="0" cellspacing="0" cellpadding="0"
                style="background-color: #f8fafc; border: 1px solid #e2e8f0; border-radius: 8px; border-collapse: separate;">
                <tr>
                  <td style="padding: 20px 24px; font-size: 15px; line-height: 1.8; color: #334155;">

                    <div style="margin-bottom: 10px;">
                      <strong style="color: #0f172a;">หมายเลขอ้างอิง :</strong> {{code}}
                    </div>

                    <div style="margin-bottom: 10px;">
                      <strong style="color: #0f172a;">หมวดหมู่เรื่องร้องเรียน :</strong> {{category}}
                    </div>

                    <div style="margin-bottom: 10px;">
                      <strong style="color: #0f172a;">ประเด็นเรื่องร้องเรียน :</strong> {{subject}} {{subject_other}}
                    </div>

                    <div style="margin-bottom: 10px;">
                      <strong style="color: #0f172a;">สาขาที่เกิดเหตุ :</strong> {{location}}
                    </div>

                    <div style="margin-bottom: 10px;">
                      <strong style="color: #0f172a;">วันที่และเวลาที่เกิดเหตุ :</strong> {{incident_date}}
                      {{incident_time}}
                    </div>

                    <div style="margin-bottom: 10px;">
                      <strong style="color: #0f172a;">รายละเอียดเพิ่มเติม :</strong> <span
                        style="white-space: pre-line;">{{detail}}</span>
                    </div>

                    <div style="margin-bottom: 10px;">
                      <strong style="color: #0f172a;">จำนวนไฟล์ :</strong> {{file_count}}
                    </div>

                    <div style="margin-bottom: 0;">
                      <strong style="color: #0f172a;">อัปเดตล่าสุด :</strong> {{update_date}} {{update_time}}
                    </div>

                    @if(due_date)
                    <div style="margin-bottom: 0;">
                      <strong style="color: #0f172a;">กำหนดส่ง :</strong> {{due_date}}
                    </div>
                    @endif

                  </td>
                </tr>
              </table>

            </td>
          </tr>

          <!-- Footer / Detail Link Row -->
          <tr>
            <td align="center" style="padding: 0 24px 24px 24px;">
              <a href="{{linkUrl}}" target="_blank"
                style="background-color: #D29E0E; color: #ffffff; font-weight: bold; font-size: 14px; padding: 6px 16px; border-radius: 6px; display: inline-block; text-decoration: none;">
                ดูรายละเอียด
              </a>
            </td>
          </tr>

        </table>
        <!-- End Card -->

      </td>
    </tr>
  </table>

</body>

</html>